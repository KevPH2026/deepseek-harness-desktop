    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "icon:mac": "node scripts/generate-icon.mjs",
    "start": "electron lib/main.js",
    "test": "vitest run --config vitest.config.ts",
    "pack:mac": "npm run icon:mac && electron-builder --dir --mac --arm64 --config electron-builder.yml --publish never -c.mac.identity=null -c.mac.hardenedRuntime=false",
    "dist:mac": "npm run icon:mac && electron-builder --mac dmg zip --arm64 --config electron-builder.yml --publish never -c.forceCodeSigning=true -c.mac.notarize=true"
  },
